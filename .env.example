# The production service uses 127.0.0.1:19083 behind a reverse proxy.
HOST=127.0.0.1
PORT=19083
DATA_DIR=/var/lib/market-intelligence

# Scheduled AI: DeepSeek is primary and Doubao is the automatic fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
ARK_API_KEY=
ARK_RESPONSES_API_URL=https://ark.cn-beijing.volces.com/api/v3/responses
ARK_VIDEO_MODEL=doubao-seed-2-0-lite-260428
ARK_TEXT_MODEL=doubao-seed-2-0-lite-260428
# Public homepage for the verified Douyin account.
DOUYIN_PROFILE_URL=https://www.douyin.com/user/MS4wLjABAAAAtrR3ZhxoEcDIwEpnBqfbNdf2R9f9w4QiSXCaRU431uuiL73K5qaBXTda0njLcQnv
# Optional verified excerpt JSON used when Douyin's server-rendered page blocks direct text access.
DOUYIN_EXCERPT_PATH=/var/lib/market-intelligence/douyin_excerpt.json
# Optional World Monitor API key (wm_...). Leave empty to keep this source disabled.
WORLDMONITOR_API_KEY=
